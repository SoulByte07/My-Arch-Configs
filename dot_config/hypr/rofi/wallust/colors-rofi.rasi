 /* wallust template - colors-rofi */

* {
active-background: #D84861;
active-foreground: #F8CBC5;
normal-background: #111112;
normal-foreground: #F8CBC5;
urgent-background: #D9495D;
urgent-foreground: #F8CBC5;

alternate-active-background: #CF4F21;
alternate-active-foreground: #F8CBC5;
alternate-normal-background: #111112;
alternate-normal-foreground: #F8CBC5;
alternate-urgent-background: #111112;
alternate-urgent-foreground: #F8CBC5;

selected-active-background: #D9495D;
selected-active-foreground: #F8CBC5;
selected-normal-background: #D9495D;
selected-normal-foreground: #F8CBC5;
selected-urgent-background: #D9495D;
selected-urgent-foreground: #F8CBC5;

background-color: #111112;
background: rgba(0,0,0,0.7);
foreground: #F8CBC5;
border-color: #D84861;

color0: #39393A;
color1: #513E54;
color2: #514460;
color3: #9B3B19;
color4: #A23648;
color5: #A33646;
color6: #B05043;
color7: #ECACA4;
color8: #A67973;
color9: #6C5270;
color10: #6C5B7F;
color11: #CF4F21;
color12: #D84861;
color13: #D9495D;
color14: #EB6A5A;
color15: #ECACA4;


}

