 /* wallust template - colors-rofi */

* {
active-background: #EECCB7;
active-foreground: #FCF6F4;
normal-background: #07000A;
normal-foreground: #FCF6F4;
urgent-background: #D6E2FA;
urgent-foreground: #FCF6F4;

alternate-active-background: #BCC3FA;
alternate-active-foreground: #FCF6F4;
alternate-normal-background: #07000A;
alternate-normal-foreground: #FCF6F4;
alternate-urgent-background: #07000A;
alternate-urgent-foreground: #FCF6F4;

selected-active-background: #D6E2FA;
selected-active-foreground: #FCF6F4;
selected-normal-background: #D6E2FA;
selected-normal-foreground: #FCF6F4;
selected-urgent-background: #D6E2FA;
selected-urgent-foreground: #FCF6F4;

background-color: #07000A;
background: rgba(0,0,0,0.7);
foreground: #FCF6F4;
border-color: #EECCB7;

color0: #07000A;
color1: #99828B;
color2: #BB6EBE;
color3: #8D92BC;
color4: #B2998A;
color5: #A0AABB;
color6: #B8ACA8;
color7: #F2E9E7;
color8: #A9A3A2;
color9: #CCADB9;
color10: #FA92FE;
color11: #BCC3FA;
color12: #EECCB7;
color13: #D6E2FA;
color14: #F5E5E0;
color15: #F2E9E7;


}

