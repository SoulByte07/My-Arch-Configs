alternate-normal-foreground: #F6F7D1;
alternate-urgent-background: #17181A;
alternate-urgent-foreground: #F6F7D1;

selected-active-background: #CED2D5;
selected-active-foreground: #F6F7D1;
selected-normal-background: #CED2D5;
selected-normal-foreground: #F6F7D1;
selected-urgent-background: #CED2D5;
