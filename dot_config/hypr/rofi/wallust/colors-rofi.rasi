 /* wallust template - colors-rofi */

* {
active-background: #E8DEDC;
active-foreground: #FBF7F4;
normal-background: #1B1B1E;
normal-foreground: #FBF7F4;
urgent-background: #F4E3D8;
urgent-foreground: #FBF7F4;

alternate-active-background: #E3D9D8;
alternate-active-foreground: #FBF7F4;
alternate-normal-background: #1B1B1E;
alternate-normal-foreground: #FBF7F4;
alternate-urgent-background: #1B1B1E;
alternate-urgent-foreground: #FBF7F4;

selected-active-background: #F4E3D8;
selected-active-foreground: #FBF7F4;
selected-normal-background: #F4E3D8;
selected-normal-foreground: #FBF7F4;
selected-urgent-background: #F4E3D8;
selected-urgent-foreground: #FBF7F4;

background-color: #1B1B1E;
background: rgba(0,0,0,0.7);
foreground: #FBF7F4;
border-color: #E8DEDC;

color0: #424145;
color1: #7F9AAD;
color2: #9D989A;
color3: #AAA3A2;
color4: #AEA6A5;
color5: #B7AAA2;
color6: #B6ADA8;
color7: #F1EAE7;
color8: #A8A4A2;
color9: #A9CEE7;
color10: #D1CBCD;
color11: #E3D9D8;
color12: #E8DEDC;
color13: #F4E3D8;
color14: #F3E7E0;
color15: #F1EAE7;


}

