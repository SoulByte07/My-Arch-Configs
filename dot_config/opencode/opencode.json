{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "assistant",
  "agent": {
    "build": {
      "model": "github-copilot/GPT-5.3-Codex"
    },
    "plan": {
      "model": "github-copilot/GPT-5.3-Codex"
    },
    "assistant": {
      "model": "github-copilot/gpt-5.2"
    },
    "code-reviewer": {
      "path": "agents/code-reviewer.yaml",
      "provider": "anthropic",
      "model": "github-copilot/GPT-5.3-Codex"
    },
    // New Cloud Engineering Agents
    "security-expert": {
      "path": "agents/security.yaml",
      "model": "github-copilot/GPT-5.3-Codex"
    },
    "aws-architect": {
      "path": "agents/aws.yaml",
      "model": "github-copilot/gpt-5.2",
      "skills": [
        "caveman",
        "aws-deploy",
        "aws-diagram",
        "aws-lambda"
      ],
      "prompt": "You are a Lead AWS Architect. Focus on High Availability, Security, and cost in INR."
    },
    //    "mcpServers": {
    //      "aws-docs": {
    //        "command": "uvx",
    //        "args": [
    //          "mcp-server-aws-docs"
    //        ]
    //      },
    //      "aws-diagram": {
    //        "command": "uvx",
    //        "args": [
    //          "mcp-server-aws-diagrams"
    //        ]
    //      }
    //    },
    "permission": {
      "read": {
        "**/.env/**": "deny",
        "**/.env.local/**": "deny",
        "**/.env": "deny",
        "**/.env.local": "deny",
        "*": "allow",
        "**/.terraform/**": "deny",
        "*.tfstate*": "deny",
        "*.tfvars": "deny",
        "*.tfvars.json": "deny",
      }
    },
  }
}
