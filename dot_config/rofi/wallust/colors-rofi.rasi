 /* wallust template - colors-rofi */

* {
active-background: #6988B0;
active-foreground: #E0E9DA;
normal-background: #000004;
normal-foreground: #E0E9DA;
urgent-background: #DBA17A;
urgent-foreground: #E0E9DA;

alternate-active-background: #BF616A;
alternate-active-foreground: #E0E9DA;
alternate-normal-background: #000004;
alternate-normal-foreground: #E0E9DA;
alternate-urgent-background: #000004;
alternate-urgent-foreground: #E0E9DA;

selected-active-background: #DBA17A;
selected-active-foreground: #E0E9DA;
selected-normal-background: #DBA17A;
selected-normal-foreground: #E0E9DA;
