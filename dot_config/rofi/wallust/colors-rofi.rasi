 /* wallust template - colors-rofi */

* {
active-background: #8BBCC5;
active-foreground: #D7E9EB;
normal-background: #000004;
normal-foreground: #D7E9EB;
urgent-background: #A3BE8C;
urgent-foreground: #D7E9EB;

alternate-active-background: #BD7E93;
alternate-active-foreground: #D7E9EB;
alternate-normal-background: #000004;
alternate-normal-foreground: #D7E9EB;
alternate-urgent-background: #000004;
alternate-urgent-foreground: #D7E9EB;

selected-active-background: #A3BE8C;
selected-active-foreground: #D7E9EB;
selected-normal-background: #A3BE8C;
selected-normal-foreground: #D7E9EB;
selected-urgent-background: #8BBCC5;
selected-urgent-foreground: #D7E9EB;

background-color: #000004;
background: rgba(0,0,0,0.7);
foreground: #D7E9EB;
border-color: #8BBCC5;

color0: #000004;
color1: #4B6583;
color2: #4D6784;
color3: #8E5F6E;
color4: #698D94;
color5: #7A8F69;
color6: #6B9095;
color7: #BED7DB;
color8: #859799;
color9: #6486AE;
color10: #678AB0;
color11: #BD7E93;
color12: #8BBCC5;
color13: #A3BE8C;
color14: #8EC0C7;
color15: #BED7DB;


}

