background-color: #000004;
background: rgba(0,0,0,0.7);
foreground: #E0E9DA;
border-color: #6988B0;

color0: #000004;
color1: #292A33;
color2: #593840;
color3: #8F494F;
color4: #4F6684;
color5: #A4795C;
color6: #7D906F;
