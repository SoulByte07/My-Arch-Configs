 /* wallust template - colors-rofi */

* {
active-background: #F3D13F;
active-foreground: #FDF8F1;
normal-background: #241C1B;
normal-foreground: #FDF8F1;
urgent-background: #FCF14A;
urgent-foreground: #FDF8F1;

alternate-active-background: #E9992A;
alternate-active-foreground: #FDF8F1;
