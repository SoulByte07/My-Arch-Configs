 /* wallust template - colors-rofi */

* {
active-background: #55586C;
active-foreground: #D0D2DA;
normal-background: #19191C;
normal-foreground: #D0D2DA;
urgent-background: #595C71;
urgent-foreground: #D0D2DA;

alternate-active-background: #424457;
alternate-active-foreground: #D0D2DA;
alternate-normal-background: #19191C;
alternate-normal-foreground: #D0D2DA;
alternate-urgent-background: #19191C;
alternate-urgent-foreground: #D0D2DA;

selected-active-background: #595C71;
selected-active-foreground: #D0D2DA;
selected-normal-background: #595C71;
selected-normal-foreground: #D0D2DA;
selected-urgent-background: #55586C;
selected-urgent-foreground: #D0D2DA;

background-color: #19191C;
background: rgba(0,0,0,0.7);
foreground: #D0D2DA;
border-color: #55586C;

color0: #404043;
color1: #12121D;
color2: #151520;
color3: #313341;
color4: #404251;
color5: #434555;
color6: #5B5F70;
color7: #B4B6C2;
color8: #7E7F87;
color9: #181826;
color10: #1C1C2B;
color11: #424457;
color12: #55586C;
color13: #595C71;
color14: #797E95;
color15: #B4B6C2;


}

