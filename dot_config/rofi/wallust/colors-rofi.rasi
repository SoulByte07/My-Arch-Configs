 /* wallust template - colors-rofi */

* {
active-background: #F2A882;
active-foreground: #F1F1F0;
normal-background: #222228;
normal-foreground: #F1F1F0;
urgent-background: #D5D1D2;
urgent-foreground: #F1F1F0;

alternate-active-background: #C39BB0;
alternate-active-foreground: #F1F1F0;
