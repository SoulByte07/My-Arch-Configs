 /* wallust template - colors-rofi */

* {
active-background: #5F8DC7;
active-foreground: #F0E8EF;
normal-background: #232124;
normal-foreground: #F0E8EF;
urgent-background: #6291CA;
urgent-foreground: #F0E8EF;

alternate-active-background: #385AA2;
alternate-active-foreground: #F0E8EF;
alternate-normal-background: #232124;
alternate-normal-foreground: #F0E8EF;
alternate-urgent-background: #232124;
alternate-urgent-foreground: #F0E8EF;

selected-active-background: #6291CA;
selected-active-foreground: #F0E8EF;
selected-normal-background: #6291CA;
selected-normal-foreground: #F0E8EF;
