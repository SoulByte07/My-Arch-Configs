# ~/.config/zsh/.zshrc

# For loggin
# Start high-resolution logging
# PS4=$'[$(date "+%s:%N")] '
# exec 3>&2 2>/tmp/zsh_trace.log
# set -x

# 1. P10k Instant Prompt (MUST BE AT TOP)
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# 2. Source modular components
source "$ZDOTDIR/options.zsh"
source "$ZDOTDIR/aliases.zsh"
source "$ZDOTDIR/functions.zsh"

# 3. Tool Initializations (FZF, Zoxide, TheFuck)
# source <(fzf --zsh)
# eval "$(zoxide init zsh --cmd cd)"
# eval "$(thefuck --alias)"

ZSH_TOOL_CACHE="$HOME/.cache/zsh/tools"
mkdir -p "$ZSH_TOOL_CACHE"

# Input: Terminal starts
# Expected Output: Reads static files instead of running 3 external binaries

# FZF Cache
[[ ! -f "$ZSH_TOOL_CACHE/fzf.zsh" ]] && fzf --zsh > "$ZSH_TOOL_CACHE/fzf.zsh"
source "$ZSH_TOOL_CACHE/fzf.zsh"

# Zoxide Cache
[[ ! -f "$ZSH_TOOL_CACHE/zoxide.zsh" ]] && zoxide init zsh --cmd cd > "$ZSH_TOOL_CACHE/zoxide.zsh"
source "$ZSH_TOOL_CACHE/zoxide.zsh"

# TheFuck Cache
# [[ ! -f "$ZSH_TOOL_CACHE/thefuck.zsh" ]] && thefuck --alias > "$ZSH_TOOL_CACHE/thefuck.zsh"
# source "$ZSH_TOOL_CACHE/thefuck.zsh"
fuck() {
    unfunction fuck
    eval "$(thefuck --alias)"
    fuck "$@"
}





source "$ZDOTDIR/plugins.zsh"

# 4. Kitty Integration (Path check for Fedora/Arch)
# [[ -f /usr/lib/kitty/shell-integration/zsh/kitty.zsh ]] && source /usr/lib/kitty/shell-integration/zsh/kitty.zsh

# 5. Theme & Overrides (MUST BE AT BOTTOM)
# Check Arch or Fedora paths for P10k
[[ -f /usr/share/zsh-theme-powerlevel10k/powerlevel10k.zsh-theme ]] && source /usr/share/zsh-theme-powerlevel10k/powerlevel10k.zsh-theme


[[ ! -f "$ZDOTDIR/p10k.zsh" ]] || source "$ZDOTDIR/p10k.zsh"




# 6. Background Auto-Compilation (Refined)
function _zcompile_async() {
    # Specifically target your modular files 
    local files=(
        "$ZDOTDIR/.zshrc"
        "$ZDOTDIR/.zshenv"
        "$ZDOTDIR/options.zsh"
        "$ZDOTDIR/aliases.zsh"
        "$ZDOTDIR/functions.zsh"
        "$ZDOTDIR/plugins.zsh"
        "$ZDOTDIR/p10k.zsh"
        /home/soul/.cache/zsh/tools/fzf.zsh
        /home/soul/.cache/zsh/tools/zoxide.zsh
    )
    
    for f in "${files[@]}"; do
        if [[ -f "$f" && "$f" -nt "${f}.zwc" ]]; then
            # Use 'zsh -c' to ensure the compilation has its own process life
            (zcompile "$f") &! 
        fi
    done
}
_zcompile_async


