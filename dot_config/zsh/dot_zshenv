# ~/.zshenv
# --- 1. XDG Base Directories ---
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_STATE_HOME="$HOME/.local/state"

export ZDOTDIR="$XDG_CONFIG_HOME/zsh"

# --- 2. Basic Paths ---
export EDITOR="nvim"
export VISUAL="nvim"
export SHELL="/usr/bin/zsh"

# Rust
# export CARGO_HOME="$XDG_DATA_HOME/cargo"

# Bun
# export BUN_INSTALL="$XDG_DATA_HOME/bun"
export PATH="$CARGO_HOME/bin:$BUN_INSTALL/bin:$PATH"

# PNPM
export PATH="$XDG_DATA_HOME/pnpm/bin:$PATH"

# User Scripts
export PATH="$HOME/.local/bin:$PATH"

export MANPAGER='nvim +Man!'

# VM
export LIBVIRT_DEFAULT_URI='qemu:///system'

# DWL
export LIBSEAT_BACKEND=seatd

# Cloud
export DOCKER_HOST=unix:///run/user/$UID/podman/podman.sock
# export DOCKER_HOST=unix:///run/user/1000/podman/podman.sock 
# export GATEWAY_LISTEN=:4566
# export LOCALSTACK_DOCKER_FLAGS="-v /run/user/1000/podman/podman.sock:/var/run/docker.sock"
# export MOUNT_DOCKER_SOCKET=0

# --- 3. PATH Optimization ---
# Keeps your PATH clean and unique
typeset -U path
# Filter out non-existent directories from PATH
path=($^path(N))

# Gemini
# export GEMINI_SANDBOX=runsc

# Steam
# export GDK_SCALE=2
# export STEAM_FORCE_DESKTOPUI_SCALING=2

. "$HOME/.cargo/env"
